{
  "openclaw": {
    "tools": [
      {
        "name": "speak_text",
        "description": "将文本转换为语音并播放。适用于需要语音播报结果的场景，如年报分析结果朗读、通知提醒等。支持中英文自动识别。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "要朗读的文本内容"
            },
            "voice": {
              "type": "string",
              "description": "语音名称。中文: xiaoxiao(女声温柔), yunxi(男声阳光), yunjian(男声成熟), xiaoyi(女声活泼), yunfeng(男声沉稳)。英文: jenny(女声), guy(男声)。默认自动选择。",
              "enum": ["xiaoxiao", "yunxi", "yunjian", "xiaoyi", "yunxia", "yunfeng", "jenny", "guy", "aria"]
            },
            "rate": {
              "type": "string",
              "description": "语速调整，如 +20% (加快), -20% (减慢)。默认 +0%",
              "default": "+0%"
            },
            "volume": {
              "type": "string",
              "description": "音量调整，如 +50% (增大), -20% (减小)。默认 +0%",
              "default": "+0%"
            }
          },
          "required": ["text"]
        }
      },
      {
        "name": "speak_from_file",
        "description": "从文件读取文本并转换为语音播放。适用于播报已保存的文本内容。",
        "parameters": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "文本文件路径"
            },
            "voice": {
              "type": "string",
              "description": "语音名称，同 speak_text",
              "enum": ["xiaoxiao", "yunxi", "yunjian", "xiaoyi", "yunxia", "yunfeng", "jenny", "guy", "aria"]
            },
            "rate": {
              "type": "string",
              "description": "语速调整",
              "default": "+0%"
            }
          },
          "required": ["file_path"]
        }
      },
      {
        "name": "save_speech_file",
        "description": "将文本转换为语音并保存为音频文件，不立即播放。适用于需要保存语音文件供后续使用。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "要转换的文本内容"
            },
            "output_dir": {
              "type": "string",
              "description": "音频文件输出目录，默认保存到 ~/.openclaw/workspace/voice-output/",
              "default": "~/.openclaw/workspace/voice-output/"
            },
            "voice": {
              "type": "string",
              "description": "语音名称",
              "enum": ["xiaoxiao", "yunxi", "yunjian", "xiaoyi", "yunxia", "yunfeng", "jenny", "guy", "aria"]
            },
            "filename": {
              "type": "string",
              "description": "输出文件名（不含扩展名），默认使用时间戳"
            }
          },
          "required": ["text"]
        }
      },
      {
        "name": "check_voice_status",
        "description": "检查语音输出系统的状态，包括依赖安装情况、可用播放器等。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "list_available_voices",
        "description": "列出所有可用的语音选项，包括中文和英文语音。",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    ]
  }
}
